# Copia este archivo como .env y llena los valores. Nunca subas el .env al repositorio.

PORT=3000

# Cadena de conexión de MongoDB Atlas (mongodb+srv://usuario:clave@cluster/NailsSoft?...)
MONGODB_CNN=

# Correo para recuperar contraseñas (con Gmail, usa una contraseña de aplicación)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=

# Secreto para firmar los tokens JWT: una cadena larga y aleatoria
JWT_SECRET=
