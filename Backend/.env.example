# Copia este archivo como .env y llena los valores. Nunca subas el .env al repositorio.

PORT=3000

# Cadena de conexión de MongoDB: local (como abajo) o de Atlas (mongodb+srv://usuario:clave@cluster/NailsSoft)
MONGODB_CNN=mongodb://127.0.0.1:27017/NailsSoft

# Correo para recuperar contraseñas (con Gmail, usa una contraseña de aplicación)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=

# Secreto para firmar los tokens JWT: mínimo 32 caracteres aleatorios.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Orígenes permitidos para CORS, separados por coma (p. ej. https://misitio.com).
# Si se deja vacío, se permite cualquier localhost / 127.0.0.1 (útil en desarrollo).
CORS_ORIGINS=
